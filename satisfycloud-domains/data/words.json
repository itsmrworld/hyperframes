  "lines": [
    {
      "text": "Every story begins with a name.",
      "start": 4.5,
      "end": 7.0,
      "first": 0,
      "last": 5
    },
    {
      "text": "A late night. A blank screen. One idea you can't let go.",
      "start": 7.6,
      "end": 12.6,
      "first": 6,
      "last": 17
    },
    {
      "text": "So you search.",
      "start": 13.1,
      "end": 14.4,
      "first": 18,
      "last": 20
    },
    {
      "text": "And your name appears. Live.",
      "start": 14.9,
      "end": 17.4,
      "first": 21,
      "last": 25
    },
    {
      "text": "Dot shop, one dollar twelve a year.",
      "start": 17.9,
      "end": 21.0,
      "first": 26,
      "last": 32
    },
    {
      "text": "Dot online, one forty-six.",
      "start": 21.2,
      "end": 23.6,
      "first": 33,
      "last": 36
    },
    {
      "text": "Dot xyz, two fifty-five.",
      "start": 23.8,
      "end": 26.0,
      "first": 37,
      "last": 40
    },
    {
      "text": "Dot org, eight forty-nine.",
      "start": 26.3,
      "end": 28.8,
      "first": 41,
      "last": 44
    },
    {
      "text": "Dot com, eleven twenty-six.",
      "start": 29.0,
      "end": 31.6,
      "first": 45,
      "last": 48
    },
    {
      "text": "Add to cart. Pay.",
      "start": 32.2,
      "end": 34.0,
      "first": 49,
      "last": 52
    },
    {
      "text": "The name is yours.",
      "start": 34.5,
      "end": 36.3,
      "first": 53,
      "last": 56
    },
    {
      "text": "Then give it a home, and go live the same day.",
      "start": 36.9,
      "end": 40.8,
      "first": 57,
      "last": 67
    },
    {
      "text": "SatisfyCloud.",
      "start": 41.4,
      "end": 42.4,
      "first": 68,
      "last": 68
    },
    {
      "text": "Claim the name your brand deserves.",
      "start": 42.8,
      "end": 45.6,
      "first": 69,
      "last": 74
    }
